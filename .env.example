# ─── Copy this file to .env.local and fill in your own values ───

# Local SQLite database file
DATABASE_URL=./linkedin-posts.db

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3060

# 32-char key used to encrypt users' stored API keys at rest
API_KEY_ENCRYPTION_KEY=

# Gathos — premium AI image generation (server-side)
GATHOS_BASE_URL=https://gathos.com/api/v1
GATHOS_IMAGE_API_KEY=
GATHOS_I2I_API_KEY=

# Note: each user adds their own Google Gemini key in the app's Settings page.
