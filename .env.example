# ─── Copy this file to .env.local and fill in your own values ───

# PostgreSQL connection string (Supabase / Neon).
# For Supabase, use the connection-pooler URI from: Settings > Database > Connection string > URI.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3060

# Key used to encrypt users' stored API keys at rest.
# Must be 32 BYTES expressed as 64 hex characters — it is parsed with
# Buffer.from(key, "hex"), so a 32-character string fails at runtime.
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_KEY=

# Real-time photo search for carousel/article images (server-side, optional).
# Absent key means that source is skipped, never a dead button — with neither
# set the app still runs on Gemini text-to-image alone.
PEXELS_API_KEY=
TAVILY_API_KEY=

# Note: each user adds their own Google Gemini key in the app's Settings page.
# It is the ONLY image engine — plain generation, and editing/altering a
# searched photo to match a slide's art direction.

SLACK_SIGNING_SECRET=
SLACK_POST_AS_EMAIL=
